nificación (","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"BxfK8uORzx"},{"type":"emphasis","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"scheduling","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"sh4BP7HLhk"}],"key":"GQlEDgaevI"},{"type":"text","value":"), control de concurrencia y políticas de asignación, determinando cómo se utilizan dichos recursos para resolver problemas computacionales complejos en entornos dinámicos.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"VDSQZR3IIh"}],"key":"qiFu9dYh6O"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/02-arq-ssoo-01-f139bf469a2773e8e7b460cb0d828fb1.png","alt":"Esquema de tres niveles para un sistema de cómputo genérico. El Sistema Operativo actúa como un intermediario entre las aplicaciones y el hardware disponible.","width":"50%","align":"center","data":{"altTextIsAutoGenerated":true},"key":"zvHcjFFfds","urlSource":"images/02-arq-ssoo-01.png","urlOptimized":"/build/02-arq-ssoo-01-f139bf469a2773e8e7b460cb0d828fb1.webp"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"02-arq-ssoo-01","identifier":"02-arq-ssoo-01","html_id":"id-02-arq-ssoo-01","enumerator":"2","children":[{"type":"text","value":"Figure ","key":"ee3hgO8wtX"},{"type":"text","value":"2","key":"YgHbD6gIfF"},{"type":"text","value":":","key":"B78Nd9TgzL"}],"template":"Figure %s:","key":"K3QmhrFD3b"},{"type":"text","value":"Esquema de tres niveles para un sistema de cómputo genérico. El Sistema Operativo actúa como un intermediario entre las aplicaciones y el hardware disponible.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"peFqOfwrv7"}],"key":"NxIE4tdou4"}],"key":"BZ83fyJB6t"}],"label":"02-arq-ssoo-